rules_version = '2';

// Security rules for the ABS exec portal.
// Published in the Firebase console: Firestore Database -> Rules. Keep this file in sync with what's published there.
//
// members/{memberId}   One exec card. Anyone can read. Execs can edit only their own email, LinkedIn and bio.
// access/{googleEmail} Who may sign in: { memberId, admin }. Only admins can see or change the whole list.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function hasAccess() {
      return signedIn() && exists(/databases/$(database)/documents/access/$(myEmail()));
    }
    function myAccess() {
      return get(/databases/$(database)/documents/access/$(myEmail())).data;
    }
    function isAdmin() {
      return hasAccess() && myAccess().admin == true;
    }

    function validText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }
    function validLinkedIn(d) {
      return !('linkedin' in d) || d.linkedin == ''
        || (d.linkedin is string && d.linkedin.size() <= 200
            && d.linkedin.matches('https://([a-z]+[.])?linkedin[.]com/.*'));
    }
    function validContact(d) {
      return validText(d, 'email', 120) && validText(d, 'bio', 400) && validLinkedIn(d);
    }
    function validMember(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.role is string && d.role.size() <= 80
        && d.team is string && d.team.size() <= 40
        && d.order is number
        && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() <= 120))
        && validContact(d);
    }

    match /members/{memberId} {
      allow read: if true;
      allow create: if isAdmin() && validMember(request.resource.data);
      allow delete: if isAdmin();
      allow update: if
        (isAdmin() && validMember(request.resource.data))
        || (hasAccess() && myAccess().memberId == memberId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'linkedin', 'bio', 'updatedAt'])
            && validContact(request.resource.data));
    }

    match /access/{email} {
      allow read: if signedIn() && (email == myEmail() || isAdmin());
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.memberId is string
        && request.resource.data.admin is bool;
      allow delete: if isAdmin() && email != myEmail();
    }

    // ---------- Members area (members.html) ----------
    // users/{uid}     An account request: { name, email, type, gradYear, status }. status starts "pending";
    //                 only admins can set it to "approved" or "declined".
    // alumni/{uid}    A directory profile. Approved users read; each alumnus edits their own.
    // resources/{id}  A link in the Resource Database. Approved users read; admins edit.

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      return request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && myUser().status == 'approved'));
    }
    function validUserFields(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.type in ['member', 'alumni']
        && (!('gradYear' in d) || d.gradYear == null || (d.gradYear is int && d.gradYear >= 1950 && d.gradYear <= 2040));
    }
    function validAlumni(d) {
      return d.keys().hasOnly(['name', 'gradYear', 'sport', 'program', 'company', 'role', 'industry', 'city', 'linkedin', 'email', 'mentor', 'bio', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('gradYear' in d) || d.gradYear == null || d.gradYear is int)
        && validText(d, 'sport', 60) && validText(d, 'program', 80) && validText(d, 'company', 80)
        && validText(d, 'role', 80) && validText(d, 'industry', 40) && validText(d, 'city', 60)
        && validText(d, 'email', 120) && validText(d, 'bio', 600) && validLinkedIn(d)
        && (!('mentor' in d) || d.mentor is bool);
    }
    function validResource(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.url is string && d.url.size() <= 500 && d.url.matches('https?://.+')
        && validText(d, 'category', 40) && validText(d, 'description', 500);
    }

    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'type', 'gradYear', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && validUserFields(request.resource.data);
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'type', 'gradYear'])
            && validUserFields(request.resource.data));
      allow delete: if isAdmin();
    }

    match /alumni/{uid} {
      allow read: if isApproved();
      allow create, update: if validAlumni(request.resource.data)
        && (isAdmin() || (isApproved() && request.auth.uid == uid));
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    match /resources/{id} {
      allow read: if isApproved();
      allow create, update: if isAdmin() && validResource(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
